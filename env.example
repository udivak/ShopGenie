# ShopGenie Bot Configuration
# Copy this file to .env and fill in your actual values

# Required: Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Request timeout in seconds (default: 10)
REQUEST_TIMEOUT=10

# Optional: Maximum retry attempts for failed requests (default: 3)
MAX_RETRY_ATTEMPTS=3

# Optional: Delay between requests in seconds (default: 1.0)
DELAY_BETWEEN_REQUESTS=1.0

# Optional: Maximum search results to scrape (default: 50)
MAX_SEARCH_RESULTS=50

# Optional: Number of top results to return to user (default: 5)
TOP_RESULTS_COUNT=5

# Optional: User agent for web scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# AliExpress Open Platform API Configuration
# Get these from https://open.aliexpress.com/
# Required for AliExpress scraping functionality
ALIEXPRESS_APP_KEY=your_aliexpress_app_key_here
ALIEXPRESS_APP_SECRET=your_aliexpress_app_secret_here

# Optional: AliExpress tracking ID for affiliate tracking
ALIEXPRESS_TRACKING_ID=your_tracking_id_here

# Optional: AliExpress API URL (default: https://api-sg.aliexpress.com/sync)
ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/sync

# eBay API Configuration
# Get these from https://developer.ebay.com/
EBAY_APP_ID=your_ebay_app_id_here
EBAY_CERT_ID=your_ebay_cert_id_here
EBAY_DEV_ID=your_ebay_dev_id_here

# eBay API Environment (sandbox or production)
EBAY_ENVIRONMENT=sandbox  # or production

# eBay API Site ID (0 for US, 3 for UK, etc.)
EBAY_SITE_ID=0